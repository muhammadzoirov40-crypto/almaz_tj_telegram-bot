# Telegram
BOT_TOKEN=123456:ABC-your-bot-token

# Database (async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/freefire

# Redis (optional, reserved)
REDIS_URL=redis://localhost:6379/0

# Admin Telegram IDs (comma-separated)
ADMIN_IDS=111111111,222222222


# Payment provider: mock | real
PAYMENT_PROVIDER=mock
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Top-up provider: mock | real
TOPUP_PROVIDER=mock
TOPUP_API_URL=
TOPUP_API_KEY=

# FireLoot partner API (real nickname lookup via POST /validate)
# https://partner.firelootshop.com - Bearer key from the partner cabinet
FIRELOOT_API_URL=https://partner.firelootshop.com/api/v1
FIRELOOT_API_KEY=

# Real Free Fire API (optional when FIRELOOT_API_KEY is set)
FREE_FIRE_API_URL=
FREE_FIRE_API_KEY=

# Manual card payment (shown to user for transfer + receipt)
PAYMENT_CARD_NUMBER=+992 002119831
PAYMENT_CARD_HOLDER=

# Balance top-up payment methods (shown to user + payment number)
# Alif card/phone number for "Alif" method
PAYMENT_ALIF_NUMBER=+992 002119831
PAYMENT_ALIF_HOLDER=Muhammad
# Dushanbe City phone number for "Dushanbe City" method
PAYMENT_DS_PHONE=+992 002119831
# Dushanbe City card number shown after the card photo (optional)
PAYMENT_DS_CARD_NUMBER=9762 0002 2086 5843
# Alif card number shown for "Alif" method (empty = falls back to PAYMENT_ALIF_NUMBER)
PAYMENT_ALIF_CARD_NUMBER=
# Payment link -> inline button "🔗 Гузариш ба пардохт" (optional, empty = no button)
# Use {amount} placeholder - it is replaced with the chosen amount (e.g. 50.00)
PAYMENT_DS_URL=https://pay.dc.tj/?a=9762000220865843&f1=337&c=DANAT.TJ&s={amount}
# Same link for the "Alif" method (empty = no button for Alif)
PAYMENT_ALIF_URL=https://pay.dc.tj/?a=9762000220865843&f1=337&c=DANAT.TJ&s={amount}

# Review channel (OTZIF_DANAT_TJ): approved top-ups are posted there.
# Leave empty to disable. Chat id appears in logs when the bot is added.
OTZIF_CHANNEL_ID=

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
USE_WEBHOOKS=false
WEBHOOK_BASE_URL=
